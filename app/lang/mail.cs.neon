registration:
    subject: "diabetes.zcu.cz - registrace"

    intro: "Vážený uživateli,"
    text_1: "váš účet na portálu diabetes.zcu.cz byl úspěšně vytvořen. Před přihlášením je nutné účet aktivovat."
    text_2: "Aktivaci provedete prostřednictvím tohoto odkazu: <a href=\"%link%\">%link%</a>"
    outro: "Portál diabetes.zcu.cz"

forgotten:
    subject: "diabetes.zcu.cz - zapomenuté heslo"

    intro: "Vážený uživateli,"
    text_1: "na portálu diabetes.zcu.cz bylo vyžádáno obnovení hesla pro účet registrovaný na tento e-mail. Pokud jste nežádal/a o obnovení vy, neklikejte na následující odkaz a e-mail ignorujte."
    text_2: "Nové heslo si můžete nastavit prostřednictvím tohoto odkazu: <a href=\"%link%\">%link%</a>"
    outro: "Portál diabetes.zcu.cz"
