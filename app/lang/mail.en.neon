registration:
    subject: "diabetes.zcu.cz - registration"

    intro: "Dear user,"
    text_1: "your account on our portal diabetes.zcu.cz was successfully created. Before you sign in, you need to activate it."
    text_2: "You can activate your account using the following link: <a href=\"%link%\">%link%</a>"
    outro: "Portal diabetes.zcu.cz"

forgotten:
    subject: "diabetes.zcu.cz - zapomenuté heslo"

    intro: "Dear user,"
    text_1: "somebody requested a password recovery on a diabetes.zcu.cz portal of an account registered to this e-mail address. If it weren't you, who requested the recovery, do not click on the following link and ignore this message."
    text_2: "You can set a new password using the following link: <a href=\"%link%\">%link%</a>"
    outro: "Portal diabetes.zcu.cz"
