homepage:
    carousel:
        item_1:
            title: "Diabetes mellitus"
            text: "is the eight most often cause of death. Nowadays, each eleventh man has diabetes."
            button_text: "I want to know more..."
        item_2:
            title: "Co-operation"
            text: "is welcome. If you want to co-operate with us, feel free to contact us."
            button_text: "I want to join the project..."
        item_3:
            title: "Blood glucose level"
            text: "is an important marker that is meauserd sporadically in the practice. Yet, we known how to calculate it from another, continously measured marker - glucose level of subcutaneous tissue."
            button_text: "I want to know more..."
        item_4:
            title: "SmartCGMS"
            text: "is a next-generation CGMS."
            button_text: "I want to know more..."

    patient:
        title: "Patient"
        text: "Explore the possibility of visualizing a continous glycemic curve along the CGMS data."
    doctor:
        title: "Physician/nurse"
        text: "Do blood and interstitial fluid glucose levels of your patients differ by several mmol/l? Let our portal to calculate a continuous curve of blood glucose level from CGMS data."
    scientist:
        title: "Researcher"
        text: "Do you deal in with a related topic? Let us know and we can co-operate."
    bussinessman:
        title: "Producer"
        text: "Do your devices help to regulate blood glucose level? We offer a glucose dynamics model to reconstruct and predict glucose level of different compartments."
    student:
        title: "Student"
        text: "We support young talents - there is a work for bachelor, master and doctoral students."
    press:
        title: "Media"
        text: "Are you interested in the diabetes? Would you like to write a paper or make a reportage?"