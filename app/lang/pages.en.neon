        resend_text: "If no e-mail has arrived into your mailbox, it is possible to request a new activation link. Before you do so, please, check the spam folder of your mailbox - sometimes such mail gets falsely classified as a spam mail."
        resend_email: "Your e-mail"
        resend_button: "Resend link"
        resend_name_required: "E-mail is required!"
        resend_success: "A new activation link has been sent to you. If you won't get this e-mail either, please, contact us and we will activate your account for you."
        resend_fail_too_early: "A new activation link has not been send - you requested a new link too early after the previous attempt."
    
    success:
