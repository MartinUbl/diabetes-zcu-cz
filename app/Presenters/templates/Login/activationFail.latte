{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>We were unable to activate your account</h3>
                <p class="lead">The link you followed is either invalid, or its validity period has expired.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-12">
        <p>If you need a new activation link, please, follow the link below:</p>
        <p><a n:href="Login:activationNeeded" class="btn btn-dark" title="Send a new link">Send a new link</a></p>
    </div>
</div>
