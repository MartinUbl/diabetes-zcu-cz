{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Sign in</h3>
                <p class="lead">Log in to access the full potential of this portal. If you don't already have an account, you can proceed with registration below.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row justify-content-md-center">
    <div class="col-xs-6 col-sm-6">
        
        {if $user->isLoggedIn()}
            
            <p>"You are already loggen in as {$user->getIdentity()->email}. To sign in as another user, <a n:href="logout!">log out</a> first.</p>
            
        {else}
        
        {ifset $loginFormError}
            <div class="alert alert-danger" role="alert">
                {$loginFormError}
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="space-1em"></div>
                </div>
            </div>
        {/ifset}
        
        {form loginForm}
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {label email /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input email class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 ">
                    {label password /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input password class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="d-grid gap-2">
                        {input submit class=>'btn btn-dark btn-block'}
                        <div class="space-1em"></div>
                    </div>
                </div>
            </div>
        {/form}
        
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 form-group">
                <div class="d-grid gap-2">
                    <a n:href="Login:forgotten" class="btn btn-secondary">Forgotten password</a>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 form-group">
                <div class="d-grid gap-2">
                    <a n:href="Login:registration" class="btn btn-secondary">Sign up</a>
                </div>
            </div>
        </div>
        
        {/if}
                
    </div>
</div>

