{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Account successfully activated!</h3>
                <p class="lead">Your account is now ready to use.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-12">
        <p>You can now access the full potential of this portal. You may now sign in using the link below.</p>
        <p><a n:href="Login:" class="btn btn-dark" title="Sign in">Sign in</a></p>
    </div>
</div>
