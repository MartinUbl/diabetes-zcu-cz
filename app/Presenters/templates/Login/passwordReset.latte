{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>{_pages.passwordreset.banner.title}</h3>
                <p class="lead">{_pages.passwordreset.banner.text}</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row justify-content-md-center">
    <div class="col-xs-6 col-sm-6">
        
        {if isset($passwordResetFormError)}
            <div class="alert alert-danger" role="alert">
                {$passwordResetFormError}
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="space-1em"></div>
                </div>
            </div>
        {/if}
        
        {form passwordResetForm}
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {label password /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input password class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {label password_again /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input password_again class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="d-grid gap-2">
                        {input submit class=>'btn btn-dark btn-block'}
                        <div class="space-1em"></div>
                    </div>
                </div>
            </div>
        {/form}
        
    </div>
</div>
