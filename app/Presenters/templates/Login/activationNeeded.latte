{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Account not activated</h3>
                <p class="lead">We need to verify your e-mail address. Please, follow the link we sent you to your mailbox.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-12">
        <p>If no e-mail has arrived into your mailbox, it is possible to request a new activation link. Before you do so, please, check the spam folder of your mailbox - sometimes such mail gets falsely classified as a spam mail.</p>
    </div>
</div>
    
<div class="row justify-content-md-center">
    <div class="col-xs-6 col-sm-6">
        
        {form resendActivationForm}
            
            {if !is_null($form['recaptcha']->getError())}
                <div class="alert alert-danger" role="alert">
                    {$form['recaptcha']->getError()}
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 form-group">
                        <div class="space-1em"></div>
                    </div>
                </div>
            {/if}
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {label email /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input email class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {input recaptcha}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="d-grid gap-2">
                        {input submit class=>'btn btn-dark btn-block'}
                        <div class="space-1em"></div>
                    </div>
                </div>
            </div>
        {/form}
        
    </div>
</div>
{/block}

{block userscripts}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{/block}