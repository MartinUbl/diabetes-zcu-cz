{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Forgotten password</h3>
                <p class="lead">Below you can find a form for requesting a renewal of your forgotten login password. Enter the e-mail you used for registration, and we will send you a link to create a new password for your account.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row justify-content-md-center">
    <div class="col-xs-6 col-sm-6">
        
        {form forgottenForm}
            
            {if isset($forgottenFormError) || !is_null($form['recaptcha']->getError())}
                <div class="alert alert-danger" role="alert">
                    {if isset($forgottenFormError)}{$forgottenFormError}{else}{$form['recaptcha']->getError()}{/if}
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 form-group">
                        <div class="space-1em"></div>
                    </div>
                </div>
            {/if}
            
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {label email /}
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    {input email class=>'form-control'}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12">
                    {input recaptcha}
                    <div class="space-1em"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12 col-sm-12 form-group">
                    <div class="d-grid gap-2">
                        {input submit class=>'btn btn-dark btn-block'}
                        <div class="space-1em"></div>
                    </div>
                </div>
            </div>
        {/form}
        
        <div class="row">
            <div class="col-xs-12 col-sm-12 col-md-6 form-group">
                <div class="d-grid gap-2">
                    <a n:href="Login:" class="btn btn-secondary">Sign in</a>
                </div>
            </div>
            <div class="col-xs-12 col-sm-12 col-md-6 form-group">
                <div class="d-grid gap-2">
                    <a n:href="Login:registration" class="btn btn-secondary">Sign up</a>
                </div>
            </div>
        </div>
        
    </div>
</div>
{/block}

{block userscripts}
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{/block}
