{block content}

<div class="row">
    
    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 marginal">
        <div class="row homepage_block">
            <div class="col-lg-8 col-md-6 col-sm-6 col-xs-8 col-8 homepage_block_text">
                <h2>SmartCGMS</h2>
                <p>
                    Explore the possibilities of powerful SmartCGMS architecture and software framework.
                </p>
                <p>
                    <a class="btn btn-sm btn-dark" n:href="Smartcgms:">Learn more</a>
                </p>
            </div>
            <div class="col-lg-4 col-md-6 col-sm-6 col-xs-4 col-4">
                <img src="{$baseUrl}/img/hp_scgms.png" class="homepage_img" />
            </div>
        </div>
    </div>
    
    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 marginal">
        <div class="row homepage_block">
            <div class="col-lg-4 col-md-6 col-sm-6 col-xs-4 col-4">
                <img src="{$baseUrl}/img/hp_icarus.png" class="homepage_img" />
            </div>
            <div class="col-lg-8 col-md-6 col-sm-6 col-xs-8 col-8 homepage_block_text">
                <h2 class="align_right">Icarus has diabetes</h2>
                <p class="align_right">
                    Learn the concepts of glycemic control through a gameplay experience. 
                </p>
                <p class="align_right">
                    <a class="btn btn-sm btn-dark" n:href="Icarus:">Learn more</a>
                </p>
            </div>
        </div>
    </div>
            
</div>
<div class="row">
            
    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 marginal">
        <div class="row homepage_block">
            <div class="col-lg-8 col-md-6 col-sm-6 col-xs-8 col-8 homepage_block_text">
                <h2>Get involved</h2>
                <p>
                    Get in touch and co-operate with us on a next-generation glucose monitoring and treatment technologies.
                </p>
                <p>
                    <a class="btn btn-sm btn-dark" n:href="Profi:">Learn more</a>
                </p>
            </div>
            <div class="col-lg-4 col-md-6 col-sm-6 col-xs-4 col-4">
                <img src="{$baseUrl}/img/hp_getinvolved.png" class="homepage_img" />
            </div>
        </div>
    </div>
    
    <div class="col-lg-6 col-md-12 col-sm-12 col-xs-12 marginal">
        <div class="row homepage_block">
            <div class="col-lg-4 col-md-6 col-sm-6 col-xs-4 col-4">
                <img src="{$baseUrl}/img/hp_development.png" class="homepage_img" />
            </div>
            <div class="col-lg-8 col-md-6 col-sm-6 col-xs-8 col-8 homepage_block_text">
                <h2 class="align_right">Publications</h2>
                <p class="align_right">
                    Read about our work in various recognized scientific journals.
                </p>
                <p class="align_right">
                    <a class="btn btn-sm btn-dark" href="{$presenter->link('About:')}#publications">Learn more</a>
                </p>
            </div>
        </div>
    </div>
    
</div>

<hr />
            
<div class="row">
    <div class="col-12">
        <div class="p-4 text-white bg-dark">
            <h3 style="padding: 0; margin: 0;">News and announcements</h3>
        </div>
    </div>
</div>

<div class="row">
    {if $news && $news->count() > 0}
        {foreach $news as $nr}
        <div class="col-4 news_block">
            <div>
                <h4>{$nr->title}</h4>
                <p class="date">{$nr->published_on->format('j M Y')}</p>
                <p class="author">Author: {$nr->users->first_name} {$nr->users->last_name}</p>
                <p class="short_text">{$nr->short_content}</p>
                <a class="readmore">Read more...</a>
            </div>
        </div>
        {/foreach}
    {else}
        <div class="col-12">
            <div class="space-1em"></div>
            <i>No news have been added yet.</i>
            <div class="space-1em"></div>
        </div>
    {/if}
</div>

<div class="row">
    <div class="col-12">
        <div class="space-1em"></div>
    </div>
</div>
