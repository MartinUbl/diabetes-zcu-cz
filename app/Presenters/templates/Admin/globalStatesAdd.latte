{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Global states</h3>
                <p class="lead">This is an editation mode for global states. Fill in the key and value of a newly added state.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-12">

        <a n:href="Admin:globalStates" class="btn btn-dark"><i class="bi bi-arrow-90deg-left"></i> Back to global states</a>
        <div class="space-1em"></div>
        
    </div>
</div>

{form globalStatesForm}
<div class="row">
    <div class="col-12 form-group">
        {label key /}
    </div>
</div>
<div class="row">
    <div class="col-12 form-group">
        {input key class => 'form-control'}
        <div class="space-1em"></div>
    </div>
</div>
<div class="row">
    <div class="col-12 form-group">
        {label value /}
    </div>
</div>
<div class="row">
    <div class="col-12 form-group">
        {input value class => 'form-control'}
        <div class="space-1em"></div>
    </div>
</div>
<div class="row">
    <div class="col-12 form-group">
        <div class="d-grid gap-2">
            {input submit class => 'btn btn-dark btn-lg'}
            <div class="space-1em"></div>
        </div>
    </div>
</div>
{/form}
