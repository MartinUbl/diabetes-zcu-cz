{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>{_pages.downloads.banner.title}</h3>
                <p class="lead">{_pages.downloads.banner.text}</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-12">
        <h3>{_pages.downloads.scgms.title}</h3>

        <p>{_pages.downloads.scgms.text_2|noescape}</p>
        
        <p>
            <a n:href="Downloads:smartcgms" class="btn btn-dark"><i class="bi bi-input-cursor"></i> {_pages.downloads.scgms.download_button}</a>
        </p>
    </div>
</div>
    
<div class="row">
    <div class="col-12">
        <h3>{_pages.downloads.database.title}</h3>

        <p>{_pages.downloads.database.text_2|noescape}</p>
        <p>{_pages.downloads.database.text_cite|noescape}</p>
        
        <p>
            <a n:href="Downloads:dataset" class="btn btn-dark"><i class="bi bi-input-cursor"></i> {_pages.downloads.database.download_button}</a>
        </p>
    </div>
</div>
    
<div class="row">
    <div class="col-12">
        <h3>{_pages.downloads.icarus.title}</h3>
        
        <p>{_pages.downloads.icarus.text_1|noescape}</p>
        
        <p>
            <a n:href="downloadIcarus!" class="btn btn-dark">{_pages.downloads.icarus.download_button}</a>
        </p>
    </div>
</div>

{/block}
    