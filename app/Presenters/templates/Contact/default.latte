{block beforeContent}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="p-5 text-white bg-dark">
                <h3>Contact us</h3>
                <p class="lead">We are located at the Faculty of Applied Sciences, University of West Bohemia. You can find us on the third floor of this building, in the informatics section. If you have any questions or wish to co-operate with us, please, do not hesitate to contact us.</p>
            </div>
        </div>
    </div>
</div>
{/block}

{block content}

<div class="row">
    <div class="col-xs-12 col-sm-12">
        
        <div class="row contactrow justify-content-center">
            <div class="col-12">
                <table class="contact-table" style="margin: auto;">
                    <tr>
                        <td class="icontd"><i class="fas fa-at"></i></td>
                        <td><a href="mailto:diabetes@mail.kiv.zcu.cz">diabetes@mail.kiv.zcu.cz</a></td>
                    </tr>
                    <tr>
                        <td class="icontd"><i class="far fa-address-card"></i></td>
                        <td>Medical informatics,<br />
                            Department of Computer Science and Engineering,<br />
                            Faculty of Applied Sciences
                        </td>
                    </tr>
                    <tr>
                        <td class="icontd"><i class="fas fa-map-marker-alt"></i></td>
                        <td>
                            Technická 8<br />
                            314 06, Plzeň
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="row contactrow">    
    <div class="col-md-4">
        <img class="img-rounded" src="{$baseUrl}/img/fav_budova.jpg" alt="tr:contact__fav_building" width="100%" />
    </div>
    <div class="col-md-8">
        <div class="embed-container">
            <iframe frameborder="1" scrolling="no" marginheight="0" marginwidth="0" src="https://maps.google.com/maps?hl=en&amp;q=Fakulta aplikovaných věd, Pilsen-Plzeň 3, Czech Republic&amp;ie=UTF8&amp;t=terrain&amp;z=15&amp;iwloc=B&amp;output=embed"></iframe>
        </div>
    </div>
</div>
    
<hr />

<div class="row contactrow">
    <div class="col-md-4" style="text-align: center;">
        <a href="http://www.fav.zcu.cz/{if $localeName == "en"}en/{/if}" target="_blank" class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/{if $localeName == "en"}fav_logo_en.png{else}fav_logo.png{/if}" alt="FAV logo" />
        </a>
    </div>
    <div class="col-md-4" style="text-align: center;">
        <a href="http://www.kiv.zcu.cz/{if $localeName == "en"}en/{/if}" target="_blank" class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/{if $localeName == "en"}kiv_logo_en.png{else}kiv_logo.png{/if}" alt="KIV logo" />
        </a>
    </div>
    <div class="col-md-4" style="text-align: center;">
        <a href="http://mi.kiv.zcu.cz/" target="_blank" class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/mi_logo.png" alt="MI logo" />
        </a>
    </div>
    <div class="col-md-4" style="text-align: center;">
        <a href="http://metabol.lfp.cuni.cz/index.asp" target="_blank" class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/fn_logo.png" alt="FN logo" />
        </a>
    </div>
    <div class="col-md-4" style="text-align: center;">
        <div class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/logo_icar.gif" alt="ICAR logo" />
        </div>
    </div>
    <div class="col-md-4" style="text-align: center;">
        <div class="logo_container">
            <img class="img-responsible logo_contact" src="{$baseUrl}/img/logo_unisa.png" alt="UNISA logo" />
        </div>
    </div>
</div>
