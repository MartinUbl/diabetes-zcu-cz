parameters:
    mail:
        noreply-from: "noreply@diabetes.zcu.cz"

application:
    errorPresenter: Error
    mapping:
        *: App\*Module\Presenters\*Presenter

session:
    expiration: 14 days

extensions:
    translation: Kdyby\Translation\DI\TranslationExtension
    recaptcha: ReCaptchaControl\DI\Extension

recaptcha:
    requester: ReCaptchaControl\Http\Requester\CurlRequester

services:
    latte.templateFactory: Nette\Bridges\ApplicationLatte\TemplateFactory
    router: App\Router\RouterFactory::createRouter

    - App\Services\Authenticator
    - App\Services\Mailer(%mail.noreply-from%)
    - App\Models\UserModel
    - App\Models\UploadsModel
    - App\Models\ExperimentModel


http:
    headers:
        X-Powered-By: "Nginx"
        Strict-Transport-Security: "max-age=31536000; includeSubDomains"
        Content-Security-Policy: "default-src 'self' 'unsafe-inline' 'unsafe-eval' nette.github.io cdn.jsdelivr.net cdnjs.cloudflare.com code.jquery.com *.fontawesome.com www.google.com www.gstatic.com"
        X-Content-Type-Options: "nosniff"
        Referrer-Policy: "no-referrer"

